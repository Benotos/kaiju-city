# Token to follow on Pump.fun / PumpSwap (Solana mint address)
KAIJU_MINT=
NEXT_PUBLIC_TOKEN_MINT=

# PumpPortal data API key. Keep this on the relay server only.
PUMPPORTAL_API_KEY=

# Public WebSocket URL exposed to the browser. Example: ws://localhost:8787
NEXT_PUBLIC_TRADE_RELAY_URL=

# Relay listener port
RELAY_PORT=8787

# Optional project community links
NEXT_PUBLIC_X_URL=
NEXT_PUBLIC_TELEGRAM_URL=
